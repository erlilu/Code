   "cell_type": "code",
   "source": [
    "# 1. 生成数据\n",
    "X, y = make_classification(n_samples=100, n_features=2, n_redundant=0,\n",
    "                           n_clusters_per_class=1, random_state=42)"
   ],
   "id": "6c01ba1d5a2356d3",
   "outputs": [],
   "execution_count": 21
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-09-06T13:17:55.453225Z",
     "start_time": "2026-09-06T13:17:55.424894Z"
    }
   },
   "cell_type": "code",
   "source": [
    "# 2. 从零实现LDA\n",
    "class LDA:\n",
    "    def fit(self, X, y):\n",
    "        # 按类别分开\n",
    "        X1, X2 = X[y == 0], X[y == 1]\n",
    "        # 计算各类别的均值向量\n",
    "        mu1, mu2 = np.mean(X1, axis=0), np.mean(X2, axis=0)\n",
    "        # 计算类内散度矩阵 S_w\n",
    "        S_w = np.dot((X1 - mu1).T, (X1 - mu1)) + np.dot((X2 - mu2).T, (X2 - mu2))\n",
    "        # 计算投影方向 w\n",
    "        self.w = np.dot(np.linalg.inv(S_w), (mu1 - mu2))\n",
    "        # 计算决策阈值\n",
    "        self.threshold = 0.5 * np.dot(self.w, (mu1 + mu2))\n",
    "\n",
    "    def predict(self, X):\n",
    "        projections = np.dot(X, self.w)\n",
    "        return (projections >= self.threshold).astype(int)"
   ],
   "id": "e8f0993c61f8976f",
   "outputs": [],
