    "# 2. 从零实现最小二乘法\n",
    "def least_squares(x, y):\n",
    "    x_mean, y_mean = np.mean(x), np.mean(y)\n",
    "    # 根据公式计算 w 和 b\n",
    "    w = np.sum((x - x_mean) * (y - y_mean)) / np.sum((x - x_mean) ** 2)\n",
    "    b = y_mean - w * x_mean\n",
    "    return w, b\n",
    "\n",
    "w, b = least_squares(X, y)\n",
    "print(f\"拟合结果: w = {w:.3f}, b = {b:.3f}\")"
   ],
